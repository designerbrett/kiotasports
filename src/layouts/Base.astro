---
interface Props {
	title: string;
	bodyClass: string;
}
const { title, bodyClass } = Astro.props;
---
<!doctype html>
<html lang="en" class="no-js">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Kiota Sports Academy | {title}</title>

	<link rel="shortcut icon" href="/favicon.ico">

	<link rel="stylesheet" href="/normalize.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
	<link rel="stylesheet" type="text/css" href="/slick/slick.css"/>
	<link rel="stylesheet" type="text/css" href="/slick/slick-theme.css">
	<link rel="stylesheet" href="/style.css">

	<script is:inline defer src="https://app.practicelobby.com/api/t.js"></script>
</head>
<body class={bodyClass}>

<header>
	<div class="container">
		<a class="logo" href="/"><img src="/images/logo.png" height="60" alt="Kiota Sports Academy home"></a>
		<div class="menu-links">
			<a class="about" href="/about">About</a>
			<a class="video" target="_blank" href="https://www.facebook.com/pg/kiotasportsacademy/videos">Videos</a>
		</div>
	</div>
	<div class="phone">
		<div class="container">
			<a class="tel ugh" href="tel:+256-784-228003"><img src="/images/tel-uganda.png" width="24" alt="Uganda National Flag"> +256-784-228003</a>
			<a class="tel ken" href="tel:+254-701-290281"><img src="/images/tel-kenya.jpg" width="24" alt="Kenya National Flag"> +254-701-290281</a>
		</div>
	</div>
</header>

<main>
<slot />
</main>

<footer>
	<div class="container">
		<ul class="social">
			<li><a target="_blank" href="https://www.instagram.com/kiotasports/" aria-label="Kiota Sports Academy on Instagram"><img height="24" src="/images/instagram.png" alt=""></a></li>
			<li><a target="_blank" href="https://www.facebook.com/kiotasportsacademy/" aria-label="Kiota Sports Academy on Facebook"><img height="24" src="/images/facebook.png" alt=""></a></li>
		</ul>
		<p>Copyright &copy; {new Date().getFullYear()} Kiota Sports Academy. All Rights Reserved.</p>
	</div>
</footer>

<script is:inline src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
<script is:inline type="text/javascript" src="/slick/slick.min.js"></script>
<slot name="scripts" />
{import.meta.env.PROD && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c71827bb43034118bb15471623fa050c"}'></script>}

</body>
</html>
